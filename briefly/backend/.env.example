# ============================================================================
# Briefly backend configuration
# Copy to `.env` and fill in. NEVER commit a real .env file.
# No key in this file is ever shipped to the iPhone app.
# ============================================================================

# --- Core -------------------------------------------------------------------
BRIEFLY_ENV=development                 # development | staging | production
BRIEFLY_LOG_LEVEL=INFO
BRIEFLY_API_HOST=0.0.0.0
BRIEFLY_API_PORT=8000
# Comma-separated origins allowed to call the API from a browser. The iOS app
# does not need CORS; this is for the admin/debug web console only.
BRIEFLY_CORS_ORIGINS=http://localhost:5173

# --- Database ---------------------------------------------------------------
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
BRIEFLY_DATABASE_URL=postgresql+psycopg://briefly:briefly@localhost:5432/briefly
BRIEFLY_DATABASE_ECHO=false

# --- Admin / pipeline authentication ---------------------------------------
# Required to call anything under /v1/admin. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
BRIEFLY_ADMIN_TOKEN=
# Optional shared key the mobile client sends as `X-Briefly-Key`. Leave blank
# to keep the read API open (it only serves already-public headlines + links).
BRIEFLY_CLIENT_API_KEY=

# --- Ingestion --------------------------------------------------------------
BRIEFLY_USER_AGENT=BrieflyNewsBot/0.1 (+https://example.com/briefly-bot)
BRIEFLY_HTTP_TIMEOUT_SECONDS=20
BRIEFLY_RESPECT_ROBOTS=true             # never set to false
BRIEFLY_MAX_ARTICLES_PER_FEED=60
BRIEFLY_INGEST_LOOKBACK_HOURS=36
# Google News RSS locale used for discovery feeds
BRIEFLY_GOOGLE_NEWS_HL=en-IN
BRIEFLY_GOOGLE_NEWS_GL=IN
BRIEFLY_GOOGLE_NEWS_CEID=IN:en

# --- Clustering -------------------------------------------------------------
BRIEFLY_CLUSTER_SIMILARITY_THRESHOLD=0.42
BRIEFLY_CLUSTER_TIME_WINDOW_HOURS=30
BRIEFLY_EMBEDDING_PROVIDER=none         # none | openai   (none = lexical TF-IDF)
BRIEFLY_EMBEDDING_MODEL=text-embedding-3-small

# --- Summarisation / fact extraction ---------------------------------------
# rule_based works with no credentials at all and is fully deterministic.
BRIEFLY_LLM_PROVIDER=rule_based         # rule_based | anthropic | openai
BRIEFLY_LLM_MODEL=claude-sonnet-4-5
BRIEFLY_LLM_MAX_TOKENS=1500
BRIEFLY_LLM_TIMEOUT_SECONDS=60
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
BRIEFLY_SUMMARY_MAX_WORDS=30            # hard cap, enforced in code, not by prompt
BRIEFLY_PROCESS_BATCH_SIZE=200          # stories per processing run, best-sourced first

# --- Text to speech ---------------------------------------------------------
BRIEFLY_TTS_PROVIDER=local              # local | elevenlabs | openai | azure
BRIEFLY_TTS_VOICE=briefly-anchor
BRIEFLY_TTS_FORMAT=mp3                  # mp3 | wav | m4a
BRIEFLY_TTS_BITRATE=48k                 # speech, mono — raise only if you hear artefacts
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Object storage for generated audio ------------------------------------
BRIEFLY_STORAGE_BACKEND=local           # local | s3
BRIEFLY_STORAGE_LOCAL_DIR=./var/media
# Public base URL the iPhone app will use to stream audio.
BRIEFLY_STORAGE_PUBLIC_BASE_URL=http://localhost:8000/media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
BRIEFLY_S3_BUCKET=
BRIEFLY_S3_ENDPOINT_URL=

# --- Scheduler --------------------------------------------------------------
BRIEFLY_SCHEDULER_ENABLED=false
BRIEFLY_INGEST_CRON=*/20 * * * *        # ingest + cluster + summarise
BRIEFLY_DAILY_PODCAST_CRON=30 0 * * *   # 06:00 IST == 00:30 UTC
BRIEFLY_SCHEDULER_TIMEZONE=Asia/Kolkata

# --- Quality control --------------------------------------------------------
BRIEFLY_QC_AUTOPUBLISH=true             # false = every item waits for review
BRIEFLY_QC_MAX_SOURCE_OVERLAP=0.55      # max verbatim overlap with any source
